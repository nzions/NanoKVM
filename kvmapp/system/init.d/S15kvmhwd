#!/bin/sh
# kvmhwd Rev2.6
#
# GPIO lines are driven BY DEVICE-TREE LINE NAME through kvmgpio (the GPIO
# chardev; the numbers below are the VENDOR kernel's global sysfs numbers and
# are used only when the board DT names no line, i.e. on the vendor kernel).
# GPIO_MODE: named = the DT names the lines; sysfs = vendor kernel, old path;
# none = cannot tell, so no line is touched and the reason is logged.
# Held outputs (oled-rst, wifi-en, hdmi-rst) live in the kvmgpio owner process
# started here; the Go server presses the key lines and reads the LEDs itself.

KVMGPIO=/kvmapp/system/tool/kvmgpio
GPIO_MODE=none

Alpha_OLED_RST_Pin=371
Beta_OLED_RST_Pin=502
Beta_OLED_SCL=595
Beta_OLED_SDA=507
WiFi_EN_Pin=506
Alpha_PWR_LED_Pin=504
Alpha_HDD_LED_Pin=505
Alpha_PWR_KEY_Pin=503
Alpha_RST_KEY_Pin=507
Beta_PWR_LED_Pin=504
Beta_PWR_KEY_Pin=503
Beta_RST_KEY_Pin=505
PCIe_HDMI_RST_Pin=451

init_alpha_hw(){
  devmem 0x030010D0 32 0x2  # I2C1_SCL
  devmem 0x030010DC 32 0x2  # I2C1_SDA
  pad_gpio 0x030010D4  # OLED_RST
  pad_gpio 0x0300103C  # GPIOA15
  pad_gpio 0x03001050  # GPIOA22
  pad_gpio 0x0300105C  # GPIOA23
  pad_gpio 0x03001060  # GPIOA24
  pad_gpio 0x03001054  # GPIOA25
  pad_gpio 0x03001058  # GPIOA27

	devmem 0x03001068 32 0x6  # GPIOA 18 UART1 RX
	devmem 0x03001064 32 0x6  # GPIOA 19 UART1 TX
	devmem 0x03001070 32 0x2  # GPIOA 28 UART2 TX
	devmem 0x03001074 32 0x2  # GPIOA 29 UART2 RX

  hw_out oled-rst ${Alpha_OLED_RST_Pin} 1  # OLED_RST

  hw_in pwr-led ${Alpha_PWR_LED_Pin}   # pwr led
  hw_in hdd-led ${Alpha_HDD_LED_Pin}   # hdd led
  hw_key pwr-key ${Alpha_PWR_KEY_Pin}  # pwr key
  hw_key rst-key ${Alpha_RST_KEY_Pin}  # rst key

  rmmod /mnt/system/ko/i2c-gpio.ko
  rmmod /mnt/system/ko/i2c-algo-bit.ko

  # rm /etc/init.d/S25wifimod
  # rm /etc/init.d/S30wifi
}

init_beta_pcie_hw(){
  pad_gpio 0x0300103C  # GPIOA15
  pad_gpio 0x03001050  # GPIOA22
  pad_gpio 0x0300105C  # GPIOA23
  pad_gpio 0x03001060  # GPIOA24
  pad_gpio 0x03001054  # GPIOA25
  pad_gpio 0x03001058  # GPIOA27

  devmem 0x030010E4 32 0x0  # SDIO CLK
  devmem 0x030010E0 32 0x0  # SDIO CMD
  devmem 0x030010DC 32 0x0  # SDIO D0
  devmem 0x030010D8 32 0x0  # SDIO D1
  devmem 0x030010D4 32 0x0  # SDIO D2
  devmem 0x030010D0 32 0x0  # SDIO D3

	devmem 0x03001068 32 0x6  # GPIOA 18 UART1 RX
	devmem 0x03001064 32 0x6  # GPIOA 19 UART1 TX
	devmem 0x03001070 32 0x2  # GPIOA 28 UART2 TX
	devmem 0x03001074 32 0x2  # GPIOA 29 UART2 RX

  hw_out oled-rst ${Beta_OLED_RST_Pin} 1  # Beta OLED_RST

  hw_in pwr-led ${Beta_PWR_LED_Pin}   # pwr led
  hw_key pwr-key ${Beta_PWR_KEY_Pin}  # pwr key
  hw_key rst-key ${Beta_RST_KEY_Pin}  # rst key
  hw_out hdmi-rst ${PCIe_HDMI_RST_Pin} 1  # LT6911 reset released

  rmmod /mnt/system/ko/i2c-gpio.ko
  rmmod /mnt/system/ko/i2c-algo-bit.ko
  insmod /mnt/system/ko/i2c-algo-bit.ko
  insmod /mnt/system/ko/i2c-gpio.ko
}

# gpio_mode_probe: decide the GPIO path from what the kernel shows. Every
# supported board DT names "oled-rst". kvmgpio has: 0 named, 3 no such line
# (vendor kernel), anything else (missing tool, ambiguous name, unreadable
# chip) is an error and leaves GPIO_MODE=none: never a guessed number.
gpio_mode_probe(){
  GPIO_MODE=none
  if [ ! -x "$KVMGPIO" ]
  then
    echo "kvmhwd: $KVMGPIO is missing: no gpio line will be touched" >&2
    return
  fi
  "$KVMGPIO" has oled-rst
  case $? in
    0) GPIO_MODE=named ;;
    3) GPIO_MODE=sysfs ;;
    *) echo "kvmhwd: cannot tell whether the DT names the gpio lines: no gpio line will be touched" >&2 ;;
  esac
  echo "kvmhwd: gpio mode $GPIO_MODE"
  if [ "$GPIO_MODE" = named ]
  then
    "$KVMGPIO" daemon || { echo "kvmhwd: kvmgpio owner failed to start: no gpio line will be held" >&2; GPIO_MODE=none; }
  fi
}

# hw_out NAME SYSFS_PIN VALUE: drive a held output (the owner keeps it).
hw_out(){
  case $GPIO_MODE in
    named)
      "$KVMGPIO" set "$1" "$3" > /dev/null || echo "kvmhwd: gpio $1=$3 failed" >&2 ;;
    sysfs)
      gpio_export "$2"
      echo out > /sys/class/gpio/gpio$2/direction
      echo "$3" > /sys/class/gpio/gpio$2/value ;;
    *)
      echo "kvmhwd: gpio $1=$3 not driven (no gpio access)" >&2 ;;
  esac
}

# hw_in NAME SYSFS_PIN: an input line needs nothing on the chardev path (readers
# request it themselves); the vendor path exports it as an input.
hw_in(){
  if [ "$GPIO_MODE" = sysfs ]
  then
    gpio_export "$2"
    echo in > /sys/class/gpio/gpio$2/direction
  fi
}

# hw_key NAME SYSFS_PIN: a key line. Chardev: the Go server requests it per
# press, so nothing here (the owner must not hold it). Vendor: export as out.
hw_key(){
  if [ "$GPIO_MODE" = sysfs ]
  then
    gpio_export "$2"
    echo out > /sys/class/gpio/gpio$2/direction
  fi
}

# pad_gpio ADDR: vendor kernel only. The mainline DT muxes these pads through
# its pinctrl, so the devmem write is redundant there and is skipped.
pad_gpio(){
  [ "$GPIO_MODE" = sysfs ] && devmem "$1" 32 0x3
}

# write_state FILE VALUE: replace FILE with VALUE atomically. The file either
# holds the old value or the whole new one, never a torn write, so a power cut
# mid-boot cannot leave a state file that looks complete but is not.
write_state(){
  printf '%s\n' "$2" > "$1.tmp" && mv "$1.tmp" "$1"
}

# gpio_export PIN: export a gpio once; a re-run finds it already exported.
gpio_export(){
  [ -d /sys/class/gpio/gpio$1 ] || echo $1 > /sys/class/gpio/export
}

# Detection runs once per device: /etc/kvm/hw is the "detection finished"
# marker and is written LAST, after every other result is stored and synced.
# A boot that dies half way finds no marker and simply detects again; a boot
# that finds the marker does nothing here. Safe to re-run.
#
# PCIe boards reboot once after detection (the original behaviour; the board
# variant is only known after the I2C probes above, and the PCIe board needs a
# boot that starts with that variant recorded, which the later init scripts
# and kvm_system rely on). The reboot is the very last step of detection
# (nothing is left half done), and is guarded by
# /etc/kvm/hw_rebooted so a missing/unwritable marker can never loop reboots.
kvm_hw_detect(){
  need_reboot=0
  if [ ! -e /etc/kvm/hdmi_version ]
  then
    rm -f /etc/kvm/hw
  fi
  if [ -e /etc/kvm/hw ]
  then
    echo "/etc/kvm/hw exist"
  else
    echo "/etc/kvm/hw not exist"
    if [ -d "/etc/kvm/" ]
    then
      echo "/etc/kvm/ exist"
    else
      mkdir /etc/kvm/
    fi
    pad_gpio 0x0300104C  # GPIOA26 / WiFi_EN
    hw_out wifi-en ${WiFi_EN_Pin} 0  # WiFi_EN

    pad_gpio 0x0300103C  # GPIOA15
    pad_gpio 0x03001050  # GPIOA22
    pad_gpio 0x0300105C  # GPIOA23
    pad_gpio 0x03001060  # GPIOA24
    pad_gpio 0x03001054  # GPIOA25
    pad_gpio 0x03001058  # GPIOA27

    devmem 0x030010D0 32 0x2  # I2C1_SCL
    devmem 0x030010DC 32 0x2  # I2C1_SDA
    pad_gpio 0x030010D4  # OLED_RST
    hw_out oled-rst ${Alpha_OLED_RST_Pin} 1  # OLED_RST (the one DT line, named: the Alpha pin only on the vendor kernel)

    kvm_tmp=$(i2cdetect -ry 1 0x3d 0x3d | grep 3d)
    if [ -n "$kvm_tmp" ]
    then
      # alpha hw
      write_state /etc/kvm/hw "alpha"
    else
      # beta/pcie hw
      [ "$GPIO_MODE" = sysfs ] && echo ${Alpha_OLED_RST_Pin} > /sys/class/gpio/unexport  # OLED_RST
      hw_out oled-rst ${Beta_OLED_RST_Pin} 1  # Beta_OLED_RST_Pin

      rmmod /mnt/system/ko/i2c-gpio.ko
      rmmod /mnt/system/ko/i2c-algo-bit.ko
      insmod /mnt/system/ko/i2c-algo-bit.ko
      insmod /mnt/system/ko/i2c-gpio.ko

      kvm_hdmi_version_detect

      kvm_tmp=$(i2cdetect -ry 5 0x3c 0x3c | grep 3c)
      # finish the shared work first, record the result last
      hw_out wifi-en ${WiFi_EN_Pin} 1
      # vendor kernel: the exported pad keeps its level once unexported; on the
      # chardev path the owner keeps wifi-en driven high for good.
      [ "$GPIO_MODE" = sysfs ] && echo ${WiFi_EN_Pin} > /sys/class/gpio/unexport  # WiFi_EN

      if [ -n "$kvm_tmp" ]
      then
        write_state /etc/kvm/hw "pcie"
        if [ ! -e /etc/kvm/hw_rebooted ]
        then
          need_reboot=1
        fi
      else
        write_state /etc/kvm/hw "beta"
        # rm /etc/init.d/S25wifimod
        # rm /etc/init.d/S30wifi
      fi
    fi
  fi
  sync

  if [ "$need_reboot" = 1 ]
  then
    # marker first (synced), then reboot: this boot reboots at most once
    write_state /etc/kvm/hw_rebooted "1" && sync
    echo "pcie hw detected: rebooting once to apply it"
    reboot
    # reboot only signals init and returns. Hold here so the later init
    # scripts do not start against hardware that is about to be reset; the
    # sleep is bounded so a reboot that fails does not hang the boot forever.
    sleep 60
  fi
}

kvm_hw_init(){
    FIND_FILE="/etc/kvm/hw"
    if [ `grep -c "alpha" $FIND_FILE` -ne '0' ]
    then
        echo "hw = alpha!"
        init_alpha_hw
    fi
    if [ `grep -c "beta" $FIND_FILE` -ne '0' ]
    then
        echo "hw = beta!"
        init_beta_pcie_hw
    fi
    if [ `grep -c "pcie" $FIND_FILE` -ne '0' ]
    then
        echo "hw = pcie!"
        init_beta_pcie_hw
    fi
}

kvm_hdmi_version_detect()
{
    if i2cdetect -ry 4 0x2c 0x2c | grep -qw "2c"; then
        write_state /etc/kvm/hdmi_version "c"
    elif i2cdetect -ry 4 0x2b 0x2b | grep -qw "2b"; then
        if i2cdetect -ry 4 0x44 0x44 | grep -qw "44"; then
            write_state /etc/kvm/hdmi_version "ux"
        else
            write_state /etc/kvm/hdmi_version "d"
        fi
    else
        write_state /etc/kvm/hdmi_version "ue"
    fi
}

case "$1" in
  start)
    gpio_mode_probe
    kvm_hw_detect
    kvm_hw_init
  ;;
  re-detect)
    # an explicit re-detect may reboot again, so clear the once-only marker too
    rm -f /etc/kvm/hw /etc/kvm/hw_rebooted
    gpio_mode_probe
    kvm_hw_detect
    kvm_hw_init
  ;;
  re-init)
    gpio_mode_probe
    kvm_hw_init
  ;;
  get_hdmi_version)
    kvm_hdmi_version_detect
  ;;
esac
