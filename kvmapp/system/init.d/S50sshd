#!/bin/sh
#
# sshd        Starts sshd.
#

# Ensure required binaries exist
[ -x /usr/bin/ssh-keygen ] || exit 0
[ -x /usr/sbin/sshd ] || exit 1

PIDFILE="/var/run/sshd.pid"

umask 077

ROOT_PASS_FILE="/etc/kvm/root.pass"
SHADOW_FILE="${SHADOW_FILE:-/etc/shadow}"

# Print crypt(root-password-guess, <setting from the shadow hash>) for one tool.
# $1 hash type id (1, 5, 6 or des), $2 busybox -m name, $3 full hash, $4 salt.
root_hash_candidates() {
    id="$1"; alg="$2"; full="$3"; salt="$4"
    if command -v cryptpw >/dev/null 2>&1; then
        cryptpw -m "$alg" -S "$full" root 2>/dev/null
        cryptpw -m "$alg" -S "$salt" root 2>/dev/null
    fi
    if command -v mkpasswd >/dev/null 2>&1; then
        mkpasswd -m "$alg" -S "$full" root 2>/dev/null
        mkpasswd -m "$alg" -S "$salt" root 2>/dev/null
    fi
    if command -v openssl >/dev/null 2>&1; then
        case "$id" in
            1|5|6) openssl passwd "-$id" -salt "$salt" root 2>/dev/null ;;
            des) openssl passwd -crypt -salt "$salt" root 2>/dev/null ;;
        esac
    fi
}

# 0 when root's password is still "root" (or empty), 1 when it is something
# else or locked, 2 when it could not be determined.
root_password_is_default() {
    hash=""
    found=0
    while IFS=: read -r shadow_user shadow_hash shadow_rest; do
        if [ "$shadow_user" = "root" ]; then
            hash="$shadow_hash"
            found=1
            break
        fi
    done < "$SHADOW_FILE"
    # no root line is "cannot tell", not an empty password
    [ "$found" -eq 1 ] || return 2
    case "$hash" in
        '') return 0 ;;
        '!'*|'*'*) return 1 ;;
        '$1$'*) id=1; alg=md5 ;;
        '$5$'*) id=5; alg=sha256 ;;
        '$6$'*) id=6; alg=sha512 ;;
        '$'*) return 2 ;;
        *) id=des; alg=des ;;
    esac
    if [ "$id" = "des" ]; then
        salt=$(printf '%s' "$hash" | cut -c1-2)
    else
        salt="${hash#\$?\$}"
        salt="${salt%%\$*}"
    fi
    out=$(root_hash_candidates "$id" "$alg" "$hash" "$salt")
    [ -n "$out" ] || return 2
    # a tool that ignored the salt cannot match by accident; any hit is exact
    printf '%s\n' "$out" | while IFS= read -r candidate; do
        [ "$candidate" = "$hash" ] && exit 7
    done
    [ $? -eq 7 ] && return 0
    return 1
}

# Set root's password to $1. The stock image has no chpasswd (not even as a
# busybox applet), so without it the SHA-512 hash is made with openssl or
# busybox mkpasswd and root's shadow entry (fields 2 and 3) is rewritten.
# The password goes over stdin, never argv. Returns non-zero on any failure.
set_root_password() {
    srp_pw="$1"
    [ -n "$srp_pw" ] || return 1
    if command -v chpasswd >/dev/null 2>&1; then
        printf 'root:%s\n' "$srp_pw" | chpasswd
        return $?
    fi

    srp_hash=""
    if command -v openssl >/dev/null 2>&1; then
        srp_hash=$(printf '%s\n' "$srp_pw" | openssl passwd -6 -stdin 2>/dev/null)
    fi
    case "$srp_hash" in
        '$6$'*) ;;
        *)
            # busybox mkpasswd reads the password from stdin when no password
            # argument is given
            srp_hash=""
            if command -v mkpasswd >/dev/null 2>&1; then
                srp_hash=$(printf '%s\n' "$srp_pw" | mkpasswd -m sha512 2>/dev/null)
            fi
            ;;
    esac
    case "$srp_hash" in
        '$6$'*) ;;
        *) return 1 ;;
    esac

    srp_days=$(( $(date +%s) / 86400 ))
    rm -f "$SHADOW_FILE.new"
    # only the first root line changes; no root line means failure, never append
    SRP_HASH="$srp_hash" SRP_DAYS="$srp_days" awk -F: -v OFS=: '
        !done && $1 == "root" && NF >= 3 { $2 = ENVIRON["SRP_HASH"]; $3 = ENVIRON["SRP_DAYS"]; done = 1 }
        { print }
        END { if (!done) exit 3 }
    ' "$SHADOW_FILE" > "$SHADOW_FILE.new" || { rm -f "$SHADOW_FILE.new"; return 1; }
    [ -s "$SHADOW_FILE.new" ] || { rm -f "$SHADOW_FILE.new"; return 1; }
    chmod 600 "$SHADOW_FILE.new" || { rm -f "$SHADOW_FILE.new"; return 1; }
    mv "$SHADOW_FILE.new" "$SHADOW_FILE" || { rm -f "$SHADOW_FILE.new"; return 1; }
}

# The image ships root:root. With password login on, that is a known password:
# replace it with a random one, kept 0600 in /etc/kvm/root.pass and shown on the
# device screen by kvm_system until the owner sets a password (the file is then
# removed). Delete the file to dismiss the page.
rotate_default_root_password() {
    [ -r "$SHADOW_FILE" ] || return 0
    root_password_is_default
    case $? in
        0) ;;
        2) echo "WARNING: cannot verify root's password (no cryptpw/mkpasswd/openssl?)" >&2; return 0 ;;
        *) return 0 ;;
    esac
    pw=$(tr -dc '23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz' < /dev/urandom | head -c 12)
    if [ "${#pw}" -ne 12 ]; then
        echo "ERROR: root password is the default but no random password could be made" >&2
        return 0
    fi
    mkdir -p /etc/kvm
    if set_root_password "$pw"; then
        printf '%s\n' "$pw" > "$ROOT_PASS_FILE.new" && chmod 600 "$ROOT_PASS_FILE.new" &&
            mv "$ROOT_PASS_FILE.new" "$ROOT_PASS_FILE"
        sync
        echo "root password was the default: rotated (see $ROOT_PASS_FILE)"
    else
        echo "ERROR: root password is the default and could not set it" >&2
    fi
}

startssh() {
    # Generate SSH keys if they do not exist
    [ ! -f /etc/ssh/ssh_host_rsa_key ] && /usr/bin/ssh-keygen -A

        printf "Starting sshd: "
        # password and public-key login are both accepted; empty passwords never
        /usr/sbin/sshd -o PermitEmptyPasswords=no
        touch /var/lock/sshd
        echo "OK"
}

start() {
    rotate_default_root_password
    if [ -e /etc/kvm/ssh_stop ]; then
        if [ -e /boot/start_ssh_once ]; then
            rm -f /boot/start_ssh_once
            startssh
        else
            echo "SSH does not start"
            exit 0
        fi
    else
        startssh
    fi
}

stop() {
        printf "Stopping sshd: "
        killall sshd 2>/dev/null
        rm -f /var/lock/sshd
        echo "OK"
}

restart() {
        stop
        start
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart|reload)
        restart
        ;;
    permanent_on)
        rm -f /etc/kvm/ssh_stop
        start
        ;;
    permanent_off)
        touch /etc/kvm/ssh_stop
        stop
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|permanent_on|permanent_off}"
        exit 1
esac

exit 0