#!/bin/sh
# no stock .ko: drivers are built into the kernel
#
# The Sophgo media drivers (soph_*, cvi_vc_drv) are built into the kernel, so
# nothing is loaded here. The one parameter the old script passed
# (soph_vc_driver.ko MaxVencChnNum=9 MaxVdecChnNum=9) is now on the kernel
# command line as cvi_vc_drv.MaxVencChnNum=9 cvi_vc_drv.MaxVdecChnNum=9
# (sd-image.sh writes it to uEnv.txt othbootargs). The parameters are 0644, so
# if the command line did not carry them, set them here from sysfs.
if [ "$1" = "start" ]
then
	P=/sys/module/cvi_vc_drv/parameters
	if [ -d "$P" ]
	then
		[ "$(cat $P/MaxVencChnNum 2>/dev/null)" = 9 ] || echo 9 > $P/MaxVencChnNum
		[ "$(cat $P/MaxVdecChnNum 2>/dev/null)" = 9 ] || echo 9 > $P/MaxVdecChnNum
	fi
	echo "kernel modules: built into the kernel, none loaded"
fi
exit 0
