#!/bin/sh

. /etc/profile

APFLAG_FILE=/tmp/wifiap

# plain_text VALUE succeeds when VALUE holds no newline or other control
# character, which would start a new line in the generated config files
plain_text() {
    [ "$(printf '%s' "$1" | LC_ALL=C tr -d '[:cntrl:]' | wc -c)" -eq "$(printf '%s' "$1" | wc -c)" ]
}

# check_wifi_credentials SSID PASS succeeds for an SSID of 1-32 bytes and a
# passphrase of at most 64 bytes, both free of control characters
check_wifi_credentials() {
    if ! plain_text "$1" || ! plain_text "$2"; then
        echo "wifi: credentials contain control characters, refusing to use them" >&2
        return 1
    fi
    if [ "${#1}" -lt 1 ] || [ "${#1}" -gt 32 ] || [ "${#2}" -gt 64 ]; then
        echo "wifi: credentials have an invalid length, refusing to use them" >&2
        return 1
    fi
}

# stop_pidfile FILE signals the process named in FILE, if it holds a number
stop_pidfile() {
    pid=$(cat "$1")
    case "$pid" in
        ''|*[!0-9]*) ;;
        *) kill "$pid" || true ;;
    esac
}

gen_hostapd_conf() {
    ssid="${1}"
    pass="${2}"
    echo "ctrl_interface=/var/run/hostapd"
    echo "ctrl_interface_group=0"
    printf 'ssid=%s\n' "${ssid}"
    echo "hw_mode=g"
    echo "channel=1"
    echo "beacon_int=100"
    echo "dtim_period=2"
    echo "max_num_sta=255"
    echo "rts_threshold=-1"
    echo "fragm_threshold=-1"
    echo "macaddr_acl=0"
    echo "auth_algs=3"
    echo "wpa=2"
    printf 'wpa_passphrase=%s\n' "${pass}"
    echo "ieee80211n=1"
}

gen_udhcpd_conf() {
    interface=${1}
    ipv4_prefix=${2}
    echo "start ${ipv4_prefix}.100"
    echo "end ${ipv4_prefix}.200"
    echo "interface ${interface}"
    echo "pidfile /var/run/udhcpd.${interface}.pid"
    echo "lease_file /var/lib/misc/udhcpd.${interface}.leases"
    echo "option subnet 255.255.255.0"
    echo "option lease 864000"
}

gen_dnsmasq_conf() {
    ipv4_prefix=${1}
    echo "bind-interfaces"
    echo "interface=wlan0"
    echo "address=/config.kvm/${ipv4_prefix}.1"
    echo "no-hosts"
    echo "dhcp-range=${ipv4_prefix}.2,${ipv4_prefix}.254"
    echo "dhcp-option=6,${ipv4_prefix}.1"
    echo "dhcp-option=3,${ipv4_prefix}.1"
    echo "dhcp-authoritative"
}

# The static-address helpers below mirror S30eth (the init scripts are installed
# one by one, so they cannot share a file). /boot/wlan.nodhcp holds the same one
# line as /boot/eth.nodhcp: <ipv4>[/<cidr>] [gateway]

clean_line() {
    echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\r//g'
}

# valid_ipv4 ADDR succeeds only for a dotted quad with decimal octets of 0-255
# and no leading zeros (the shell would read those as octal)
valid_ipv4() {
    case "$1" in
        ''|*[!0-9.]*) return 1 ;;
    esac
    IFS=. read -r _a _b _c _d _rest <<EOF
$1
EOF
    [ -z "$_rest" ] || return 1
    for _o in "$_a" "$_b" "$_c" "$_d"; do
        case "$_o" in
            ''|0?*) return 1 ;;
        esac
        [ "${#_o}" -le 3 ] && [ "$_o" -le 255 ] || return 1
    done
}

calc_gw() {
    addr="$1"
    netid="$2"
    IFS=. read -r a b c d <<EOF
$addr
EOF
    ipnum=$(( (a<<24) + (b<<16) + (c<<8) + d ))
    mask=$(( 0xFFFFFFFF << (32-netid) & 0xFFFFFFFF ))
    gwnum=$(( (ipnum & mask) | 1 ))
    if [ "$gwnum" -eq "$ipnum" ]; then
        broadcast=$(( (ipnum & mask) | (0xFFFFFFFF & ~mask) ))
        gwnum=$(( broadcast - 1 ))
    fi
    echo "$(( (gwnum>>24)&255 )).$(( (gwnum>>16)&255 )).$(( (gwnum>>8)&255 )).$(( gwnum&255 ))"
}

# static_wlan applies the first usable line of /boot/wlan.nodhcp to wlan0 and
# succeeds only when one was applied
static_wlan() {
    while IFS= read -r line || [ -n "$line" ]; do
        line=$(clean_line "$line")
        [ -z "$line" ] && continue
        IFS=' ' read -r inet gw _extra <<EOF
$line
EOF
        [ -z "$inet" ] && continue
        case "$inet" in
            */*)
                netid_check=${inet#*/}
                case "$netid_check" in
                    ''|*[!0-9]*) inet="${inet%/*}/16" ;;
                    *) if [ "${#netid_check}" -gt 2 ] || [ "$netid_check" -lt 1 ] || [ "$netid_check" -gt 32 ]; then
                           inet="${inet%/*}/16"
                       fi ;;
                esac
                ;;
            *)
                inet="$inet/16"
                ;;
        esac
        addr=${inet%/*}
        netid=${inet#*/}
        if ! valid_ipv4 "$addr"; then
            echo "wlan.nodhcp: ignoring invalid address" >&2
            continue
        fi
        if [ -n "$gw" ] && ! valid_ipv4 "$gw"; then
            echo "wlan.nodhcp: ignoring invalid gateway" >&2
            continue
        fi
        # a /32 has no peer to guess: no gateway means no default route
        [ -z "$gw" ] && [ "$netid" != 32 ] && gw=$(calc_gw "$addr" "$netid")
        arping -Dqc2 -Iwlan0 "$addr" || continue
        ip a add "$inet" brd + dev wlan0
        if [ -n "$gw" ]; then
            # a /32's gateway is outside the subnet: reach it with a host route first
            [ "$netid" = 32 ] && ip r add "$gw" dev wlan0
            ip r add default via "$gw" dev wlan0
            printf 'nameserver %s\n' "$gw" >> /etc/resolv.conf
        fi
        return 0
    done < /boot/wlan.nodhcp
    return 1
}

# ip_config gives wlan0 its station-mode address: static from /boot/wlan.nodhcp
# when that has a usable line, otherwise DHCP. The older /boot/wifi.nodhcp flag
# (no DHCP, no address) still applies when there is no wlan.nodhcp.
ip_config() {
    if [ -e /boot/wlan.nodhcp ]; then
        static_wlan && return 0
    elif [ -e /boot/wifi.nodhcp ]; then
        return 0
    fi
    (udhcpc -i wlan0 -t 10 -T 1 -A 5 -b -p /run/udhcpc.wlan0.pid) &
}

# ip_apply re-applies the address of a running station without touching
# wpa_supplicant, so the Wi-Fi join stays up. The AP keeps its fixed address.
ip_apply() {
    if [ -f "$APFLAG_FILE" ]; then
        echo "wifi: access-point mode keeps its own address" >&2
        return 0
    fi
    if [ -e /run/udhcpc.wlan0.pid ]; then
        stop_pidfile /run/udhcpc.wlan0.pid
        rm -f /run/udhcpc.wlan0.pid
    fi
    ip addr flush dev wlan0
    ip route del default dev wlan0 2>/dev/null || true
    ip_config
}

start() {
    echo "wifi mode: sta"
    ssid=""
    pass=""
    if [ -e /boot/wifi.ssid ] && [ -e /boot/wifi.pass ]; then
        echo "Updating WiFi credentials from /boot to /etc/kvm/"

        rm -f /etc/kvm/wifi.ssid /etc/kvm/wifi.pass

        mv /boot/wifi.ssid /etc/kvm/wifi.ssid
        mv /boot/wifi.pass /etc/kvm/wifi.pass

        chown root:root /etc/kvm/wifi.ssid /etc/kvm/wifi.pass
        chmod 644 /etc/kvm/wifi.ssid
        chmod 600 /etc/kvm/wifi.pass
    fi
    if [ -e /etc/kvm/wifi.ssid ]; then
        ssid=$(cat /etc/kvm/wifi.ssid)
    fi
    if [ -e /etc/kvm/wifi.pass ]; then
        pass=$(cat /etc/kvm/wifi.pass)
    fi
    # credentials: keep them root-only, including files from older releases
    [ -e /etc/kvm/wifi.pass ] && chmod 600 /etc/kvm/wifi.pass
    check_wifi_credentials "$ssid" "$pass" || return 1
    (
        umask 077
        echo "ctrl_interface=/var/run/wpa_supplicant" >/etc/wpa_supplicant.conf
        wpa_passphrase "$ssid" "$pass" >>/etc/wpa_supplicant.conf
    )
    chmod 600 /etc/wpa_supplicant.conf
    wpa_supplicant -B -i wlan0 -c /etc/wpa_supplicant.conf
    ip_config
}

ap_start() {
    echo "wifi mode: ap"
    id2=$(printf "%d" "0x$(sha512sum /sys/class/cvi-base/base_uid | head -c 2)")
    id3=$(printf "%d" "0x$(sha512sum /sys/class/cvi-base/base_uid | head -c 4 | tail -c 2)")
    if [ "$id2" = "$id3" ]; then
        id2=$((id2 + 1))
    fi
    if [ "$id2" -ge 255 ]; then
        id2=253
    fi
    if [ "$id3" -ge 255 ]; then
        id3=254
    fi
    ssid=""
    pass=""
    if [ -e /kvmapp/kvm/ap.ssid ]; then
        ssid=$(cat /kvmapp/kvm/ap.ssid)
    fi
    if [ -e /kvmapp/kvm/ap.pass ]; then
        pass=$(cat /kvmapp/kvm/ap.pass)
    fi
    check_wifi_credentials "$ssid" "$pass" || return 1
    (
        umask 077
        gen_hostapd_conf "$ssid" "$pass" >/etc/hostapd.conf
    )
    chmod 600 /etc/hostapd.conf
    ipv4_prefix="10.$id3.$id2"
    if [ ! -e /etc/udhcpd.wlan0.conf ]; then
        gen_udhcpd_conf wlan0 "${ipv4_prefix}" >/etc/udhcpd.wlan0.conf
    fi
    # gen_dnsmasq_conf "${ipv4_prefix}"  > /etc/dnsmasq.conf

    # iptables --policy INPUT ACCEPT
    # iptables --policy FORWARD ACCEPT
    # iptables --policy OUTPUT ACCEPT
    # iptables -F
    # iptables -t nat -F
    # iptables -t nat -A PREROUTING -i wlan0 -p udp --dport 53 -j DNAT --to ${ipv4_prefix}.1

    ifconfig wlan0 up
    ip route del default || true
    ip add flush dev wlan0
    ip addr add "$ipv4_prefix.1/24" dev wlan0
    # dnsmasq --pid-file=/tmp/dnsmasq.run -C /etc/dnsmasq.conf
    hostapd -B -i wlan0 /etc/hostapd.conf
    udhcpd -S /etc/udhcpd.wlan0.conf

    if [ ! -f "$APFLAG_FILE" ]; then
        touch "$APFLAG_FILE"
    fi

}

stop() {
    ps -ef | grep hostapd | grep -v grep | awk '{print $1}' | xargs kill -2 || true
    ps -ef | grep "udhcpd -S /etc/udhcpd.wlan0.conf" | grep -v grep | awk '{print $1}' | xargs kill -2 || true
    killall wpa_supplicant || true
    if [ -e /run/udhcpc.wlan0.pid ]; then
        stop_pidfile /run/udhcpc.wlan0.pid
        rm -f /run/udhcpc.wlan0.pid
    fi
    if [ -e /var/run/udhcpd.wlan0.pid ]; then
        stop_pidfile /var/run/udhcpd.wlan0.pid
        rm -f /var/run/udhcpd.wlan0.pid
    fi
    if [ -e /tmp/dnsmasq.run ]; then
        stop_pidfile /tmp/dnsmasq.run
        rm -f /tmp/dnsmasq.run
    fi
    # if [ -e /etc/wpa_supplicant.conf]
    # then
    # 	echo > /etc/wpa_supplicant.conf
    # fi
    airmon-ng stop wlan0mon || true

    if [ -f "$APFLAG_FILE" ]; then
        rm "$APFLAG_FILE"
    fi
}

restart() {
    stop
    start
}

if [ "${1}" = "start" ]; then
    start
elif [ "${1}" = "stop" ]; then
    stop
elif [ "${1}" = "ap" ]; then
    stop
    ap_start
elif [ "${1}" = "restart" ]; then
    restart
elif [ "${1}" = "ip" ]; then
    ip_apply
fi
