#!/bin/sh
# nanokvm Rev3.1

wait_for_exit() {
    process="$1"
    timeout="$2"
    elapsed=0

    while pidof "$process" >/dev/null 2>&1; do
        if [ "$elapsed" -ge "$timeout" ]; then
            return 1
        fi
        sleep 1
        elapsed=$((elapsed + 1))
    done
    return 0
}

stop_process() {
    process="$1"

    if ! pidof "$process" >/dev/null 2>&1; then
        return
    fi

    killall -INT "$process" 2>/dev/null || true
    if wait_for_exit "$process" 20; then
        return
    fi

    killall -TERM "$process" 2>/dev/null || true
    if wait_for_exit "$process" 5; then
        return
    fi

    killall -KILL "$process" 2>/dev/null || true
    wait_for_exit "$process" 2 || true
}

# Run from /kvmapp, not from a copy in /tmp. Why that is safe: the OTA
# (server/service/application/install.go) renames /kvmapp to /root/old and the
# staged /kvmapp.new to /kvmapp, whole directories at a time. Rename never
# rewrites a file in place, so the running binary's old inode lives on untouched
# (now under /root/old): no ETXTBSY and no corruption. After the
# OTA it calls `S95nanokvm restart`, which restarts the supervised programs from
# the new files. Running in place also keeps os.Executable() under /kvmapp/server,
# where the web files and the picoclaw profile paths are resolved.
SUPERVISE=/kvmapp/system/nanokvm-supervise
FIREWALL=/kvmapp/system/nanokvm-firewall
SERVER_BIN=/kvmapp/server/NanoKVM-Server
SYSTEM_BIN=/kvmapp/kvm_system/kvm_system
SERVER_PID=/run/nanokvm-server.supervisor.pid
SYSTEM_PID=/run/nanokvm-kvm_system.supervisor.pid

apply_firewall() {
    if [ ! -f "$FIREWALL" ]; then
        echo "S95nanokvm: $FIREWALL missing: NO FIREWALL APPLIED, box is open" >&2
        return 0
    fi
    # A failure leaves the previous state in place (the script says why) and must
    # not stop the KVM from coming up.
    /bin/sh "$FIREWALL" || echo "S95nanokvm: firewall script FAILED (see above): inbound state unchanged" >&2
}

# start_watched <name> <pidfile> <program>: run a program under the supervisor
start_watched() {
    name="$1"
    pidfile="$2"
    prog="$3"

    if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile" 2>/dev/null)" 2>/dev/null; then
        return
    fi
    if [ -f "$SUPERVISE" ]; then
        /bin/sh "$SUPERVISE" "$name" "$pidfile" "$prog" &
    else
        echo "S95nanokvm: $SUPERVISE missing: starting $name WITHOUT a supervisor" >&2
        "$prog" &
    fi
}

# stop_watched <name> <pidfile>: stop the supervisor first (it forwards SIGINT to
# the program and does not restart it), then fall back to the by-name escalation
stop_watched() {
    name="$1"
    pidfile="$2"
    sup=""

    if [ -f "$pidfile" ]; then
        sup=$(cat "$pidfile" 2>/dev/null)
        if [ -n "$sup" ] && kill -0 "$sup" 2>/dev/null; then
            kill -TERM "$sup" 2>/dev/null || true
            waited=0
            while kill -0 "$sup" 2>/dev/null && [ "$waited" -lt 25 ]; do
                sleep 1
                waited=$((waited + 1))
            done
        fi
    fi
    stop_process "$name"
    # the program is gone; a supervisor still alive would only restart it
    if [ -n "$sup" ] && kill -0 "$sup" 2>/dev/null; then
        kill -KILL "$sup" 2>/dev/null || true
    fi
    rm -f "$pidfile"
}

# Feed /dev/watchdog with busybox's applet, if the board has both. It is started
# once and deliberately NOT stopped by `stop`/`restart` (a restart or an OTA takes
# longer than the timeout would allow without it). It only starts when the device
# node and the applet exist, so a board without them is unchanged. If the applet
# dies without a clean close, the board reboots after the timeout: that is the
# watchdog doing its job.
start_watchdog() {
    [ -c /dev/watchdog ] || return 0
    command -v watchdog >/dev/null 2>&1 || return 0
    pidof watchdog >/dev/null 2>&1 && return 0
    watchdog -t 5 -T 30 /dev/watchdog || echo "S95nanokvm: watchdog applet failed to start" >&2
}

# install.go swaps an update in by renaming whole directories: /kvmapp -> /root/old,
# then /kvmapp.new -> /kvmapp. Power lost between the two renames leaves /kvmapp
# missing with a complete tree in /kvmapp.new (synced before the swap began) or in
# /root/old. This file runs from /etc/init.d (kvm_system's system_init copies it
# there), so it works with /kvmapp missing: it depends on nothing under /kvmapp.
recover_interrupted_update() {
    if [ ! -d /kvmapp ]; then
        if [ -d /kvmapp.new ]; then
            echo "S95nanokvm: interrupted update: completing it from /kvmapp.new" >&2
            mv /kvmapp.new /kvmapp
        elif [ -d /root/old ]; then
            echo "S95nanokvm: interrupted update: rolling back to /root/old" >&2
            mv /root/old /kvmapp
        else
            echo "S95nanokvm: /kvmapp is missing and nothing can restore it" >&2
        fi
        sync
    elif [ -d /kvmapp.new ]; then
        echo "S95nanokvm: removing stale /kvmapp.new from an interrupted update" >&2
        rm -rf /kvmapp.new
    fi
}

stop_services() {
    # The server owns VI/VPSS. Let it release MMF before stopping kvm_system.
    stop_watched NanoKVM-Server "$SERVER_PID"
    stop_watched kvm_system "$SYSTEM_PID"
    # copies left in /tmp by releases that ran from there
    rm -rf /tmp/kvm_system /tmp/server
}

start_services() {
    if [ -f /kvmapp/kvm_new_app ]; then
        touch /tmp/.nanokvm_migrating
        start_watched kvm_system "$SYSTEM_PID" "$SYSTEM_BIN"

        # The legacy migration invokes this init script recursively and starts
        # the server itself. Wait for that single migration path to finish.
        migration_wait=0
        while [ "$migration_wait" -lt 30 ]; do
            if [ ! -f /kvmapp/kvm_new_app ] && pidof NanoKVM-Server >/dev/null 2>&1; then
                rm -f /tmp/.nanokvm_migrating
                return
            fi
            sleep 1
            migration_wait=$((migration_wait + 1))
        done
        rm -f /tmp/.nanokvm_migrating
    else
        start_watched kvm_system "$SYSTEM_PID" "$SYSTEM_BIN"
    fi

    if ! pidof NanoKVM-Server >/dev/null 2>&1; then
        start_watched NanoKVM-Server "$SERVER_PID" "$SERVER_BIN"
    fi
}

case "$1" in
  start)
    recover_interrupted_update
    echo -n kvm > /boot/hostname.prefix
    [ -e /root/.profile ] || printf '%s\n' 'export PS1="\u@\h:\w# "' > /root/.profile

    # Copy sensor config if the file exists
    [ -f /mnt/data/sensor_cfg.ini.LT ] && cp /mnt/data/sensor_cfg.ini.LT /mnt/data/sensor_cfg.ini

    # Generate unique device key
    if [ -f /sys/class/cvi-base/base_uid ]; then
        str_value=$(awk '{print $2}' /sys/class/cvi-base/base_uid)
        first_uint=$(echo "$str_value" | cut -d'_' -f1)
        second_uint=$(echo "$str_value" | cut -d'_' -f2)
        echo "$first_uint$second_uint" > /device_key
    fi

    # Credentials and secrets are root-only, including files from older releases
    for f in /etc/kvm/wifi.pass /etc/kvm/server.yaml /etc/kvm/pwd /etc/kvm/initial.pass \
        /etc/kvm/.picoclaw_internal_token /etc/wpa_supplicant.conf /etc/hostapd.conf \
        /kvmapp/kvm/ap.pass; do
        [ -e "$f" ] && chmod 600 "$f"
    done

    # Default-DROP inbound firewall (own chain, idempotent; also removes the old
    # ad hoc rules). Never blocks startup.
    apply_firewall

    # Logo selection
    if [ -f /boot/logo.ico ]; then
        if [ ! -f /kvmapp/server/web/original.ico ]; then
            mv /kvmapp/server/web/sipeed.ico /kvmapp/server/web/original.ico
            cp /boot/logo.ico /kvmapp/server/web/sipeed.ico
        fi
    else
        if [ -f /kvmapp/server/web/original.ico ]; then
            mv /kvmapp/server/web/original.ico /kvmapp/server/web/sipeed.ico
        fi
    fi

    # Start services
    start_services
    start_watchdog
   ;;

  firewall)
    apply_firewall
   ;;

  stop)
    stop_services
    echo "OK"
   ;;

  restart)
    if [ -f /tmp/.nanokvm_migrating ]; then
        exit 0
    fi
    recover_interrupted_update
    stop_services
    start_services

    sync
    echo "OK"
   ;;
    
  *)
    echo "Usage: $0 {start|stop|restart|firewall}"
    exit 1
  ;;
esac
