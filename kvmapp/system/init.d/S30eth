#!/bin/sh

RESERVE_INET="192.168.90.1/22"

clean_line() {
    echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/\r//g'
}

# valid_ipv4 ADDR succeeds only for a dotted quad with decimal octets of 0-255
# and no leading zeros (the shell would read those as octal)
valid_ipv4() {
    case "$1" in
        ''|*[!0-9.]*) return 1 ;;
    esac
    IFS=. read -r _a _b _c _d _rest <<EOF
$1
EOF
    [ -z "$_rest" ] || return 1
    for _o in "$_a" "$_b" "$_c" "$_d"; do
        case "$_o" in
            ''|0?*) return 1 ;;
        esac
        [ "${#_o}" -le 3 ] && [ "$_o" -le 255 ] || return 1
    done
}

calc_gw() {
    addr="$1"
    netid="$2"
    IFS=. read -r a b c d <<EOF
$addr
EOF
    ipnum=$(( (a<<24) + (b<<16) + (c<<8) + d ))
    mask=$(( 0xFFFFFFFF << (32-netid) & 0xFFFFFFFF ))
    gwnum=$(( (ipnum & mask) | 1 ))
    if [ "$gwnum" -eq "$ipnum" ]; then
        broadcast=$(( (ipnum & mask) | (0xFFFFFFFF & ~mask) ))
        gwnum=$(( broadcast - 1 ))
    fi
    echo "$(( (gwnum>>24)&255 )).$(( (gwnum>>16)&255 )).$(( (gwnum>>8)&255 )).$(( gwnum&255 ))"
}

# --- hostname ---------------------------------------------------------------
# /boot/hostname (non-empty) wins and is applied unchanged; the web UI writes it
# too, so a name set there persists and beats the automatic one. With none, the
# name is nanokvm-<id>, <id> being the last 4 characters of the board serial
# (SoC unique id, then device-tree serial-number, then the /proc/cpuinfo Serial)
# and failing that the last 4 hex digits of eth0's MAC. An id that is empty, all
# zeros or all f does not count. This runs before udhcpc and avahi start, so DHCP
# sends it and mDNS advertises it. Nothing is written to /boot: idempotent.
HN_FILE=/boot/hostname
HN_ETC=/etc/hostname
AVAHI_CONF=/etc/avahi/avahi-daemon.conf

# hn_id4 STRING prints the last 4 of [0-9a-z] in STRING, lowercased, and fails
# when there are fewer than 4 or they are all 0 or all f
hn_id4() {
    _s=$(printf '%s' "$1" | tr 'A-Z' 'a-z' | tr -cd '0-9a-z')
    [ "${#_s}" -ge 4 ] || return 1
    _s=${_s#"${_s%????}"}
    case "$_s" in
        0000|ffff) return 1 ;;
    esac
    printf '%s' "$_s"
}

hn_serial() {
    _raw=""
    if [ -r /sys/class/cvi-base/base_uid ]; then
        # "<label> <hi>_<lo>": the id is the second word
        _raw=$(awk 'NR == 1 { print ($2 != "" ? $2 : $1) }' /sys/class/cvi-base/base_uid)
        hn_id4 "$_raw" && return 0
    fi
    for _f in /proc/device-tree/serial-number /sys/firmware/devicetree/base/serial-number; do
        if [ -r "$_f" ]; then
            _raw=$(tr -d '\000' < "$_f")
            hn_id4 "$_raw" && return 0
        fi
    done
    if [ -r /proc/cpuinfo ]; then
        _raw=$(sed -n 's/^Serial[[:space:]]*:[[:space:]]*//p' /proc/cpuinfo)
        hn_id4 "$_raw" && return 0
    fi
    return 1
}

hn_mac() {
    [ -r /sys/class/net/eth0/address ] || return 1
    _raw=$(cat /sys/class/net/eth0/address)
    case "$_raw" in
        00:00:00:00:00:00|ff:ff:ff:ff:ff:ff) return 1 ;;
    esac
    hn_id4 "$(printf '%s' "$_raw" | tr -d ':')"
}

set_hostname() {
    _want=""
    if [ -s "$HN_FILE" ]; then
        _want=$(tr -d '\r\n' < "$HN_FILE")
    fi
    if [ -z "$_want" ]; then
        _id=$(hn_serial) || _id=$(hn_mac) || _id=""
        if [ -z "$_id" ]; then
            echo "S30eth: no board serial and no eth0 MAC: keeping the hostname $(hostname)" >&2
            return 0
        fi
        _want="nanokvm-$_id"
    fi
    _old=$(tr -d '\r\n' < "$HN_ETC" 2>/dev/null)
    if [ "$_old" != "$_want" ]; then
        printf '%s\n' "$_want" > "$HN_ETC.tmp" && mv "$HN_ETC.tmp" "$HN_ETC"
        # keep /etc/hosts resolving the old name, as the web UI does
        if [ -n "$_old" ] && [ -w /etc/hosts ] && grep -qF "$_old" /etc/hosts; then
            sed "s/$_old/$_want/g" /etc/hosts > /etc/hosts.tmp && cat /etc/hosts.tmp > /etc/hosts
            rm -f /etc/hosts.tmp
        fi
    fi
    hostname "$_want"
    # avahi advertises the kernel hostname unless its config pins one
    if [ -f "$AVAHI_CONF" ] && grep -q '^host-name=' "$AVAHI_CONF"; then
        sed "s/^host-name=.*/host-name=$_want/" "$AVAHI_CONF" > "$AVAHI_CONF.tmp" && cat "$AVAHI_CONF.tmp" > "$AVAHI_CONF"
        rm -f "$AVAHI_CONF.tmp"
    fi
}

start() {
    set_hostname
    HN=$(hostname)
    ip addr flush dev eth0
    if [ -e /boot/eth.nodhcp ]; then
        while IFS= read -r line || [ -n "$line" ]; do
            line=$(clean_line "$line")
            [ -z "$line" ] && continue
            # first word is the address, the second the optional gateway; split
            # with read, not by expanding the line unquoted
            IFS=' ' read -r inet gw _extra <<EOF
$line
EOF
            [ -z "$inet" ] && continue
            # Check if inet contains a valid netmask, if not, add default /16
            case "$inet" in
                */*)
                    # Already has netmask, check if valid (1-32)
                    netid_check=${inet#*/}
                    case "$netid_check" in
                        ''|*[!0-9]*) inet="${inet%/*}/16" ;;
                        *) if [ "${#netid_check}" -gt 2 ] || [ "$netid_check" -lt 1 ] || [ "$netid_check" -gt 32 ]; then
                               inet="${inet%/*}/16"
                           fi ;;
                    esac
                    ;;
                *)
                    # No netmask, add default /16
                    inet="$inet/16"
                    ;;
            esac
            addr=${inet%/*}
            netid=${inet#*/}
            # the values come from a file on the FAT partition: only an IPv4
            # address and gateway go any further
            if ! valid_ipv4 "$addr"; then
                echo "eth.nodhcp: ignoring invalid address" >&2
                continue
            fi
            if [ -n "$gw" ] && ! valid_ipv4 "$gw"; then
                echo "eth.nodhcp: ignoring invalid gateway" >&2
                continue
            fi
            # a /32 has no peer to guess: no gateway means no default route
            [ -z "$gw" ] && [ "$netid" != 32 ] && gw=$(calc_gw "$addr" "$netid")
            arping -Dqc2 -Ieth0 "$addr" || continue
            ip a add "$inet" brd + dev eth0
            if [ -n "$gw" ]; then
                # a /32's gateway is outside the subnet: reach it with a host route first
                [ "$netid" = 32 ] && ip r add "$gw" dev eth0
                ip r add default via "$gw" dev eth0
                printf 'nameserver %s\n' "$gw" >> /etc/resolv.conf
            fi
            break
        done < /boot/eth.nodhcp

        ip a show dev eth0 | grep inet > /dev/null || {
            udhcpc -i eth0 -x "hostname:$HN" -t 3 -T 1 -A 5 -b -p /run/udhcpc.eth0.pid &>/dev/null
            ip a show dev eth0 | grep inet > /dev/null
        } || {
            inet=$RESERVE_INET
            addr=${inet%/*}
            ip a add "$inet" brd + dev eth0
        } || exit 1
    else
        udhcpc -i eth0 -x "hostname:$HN" -t 10 -T 1 -A 5 -b -p /run/udhcpc.eth0.pid &
    fi
}

stop() {
    [ ! -e "/run/udhcpc.eth0.pid" ] && exit 1
    pid=$(cat /run/udhcpc.eth0.pid)
    case "$pid" in
        ''|*[!0-9]*) ;;
        *) kill "$pid" ;;
    esac
    rm -f /run/udhcpc.eth0.pid
}

case "$1" in
    start) start ;;
    stop) stop ;;
    restart|reload)
        "$0" stop
        "$0" start
        ;;
    *) exit 1 ;;
esac